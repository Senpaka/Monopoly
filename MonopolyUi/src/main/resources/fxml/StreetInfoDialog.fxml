<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.StreetInfoController"
      spacing="15" alignment="TOP_CENTER"
      style="-fx-background-color: #181825; -fx-padding: 25;
             -fx-border-color: #89b4fa; -fx-border-width: 2; -fx-border-radius: 10;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">

    <Label fx:id="nameLabel" text="Название улицы"
           style="-fx-text-fill: #cdd6f4; -fx-font-size: 22px; -fx-font-weight: bold;
                  -fx-wrap-text: true; -fx-text-alignment: center;"/>

    <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 10;">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="💰 Цена:" style="-fx-text-fill: #bac2de; -fx-font-size: 15px;" minWidth="100"/>
            <Label fx:id="priceLabel" text="-"
                   style="-fx-text-fill: #a6e3a1; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="🏠 Аренда:" style="-fx-text-fill: #bac2de; -fx-font-size: 15px;" minWidth="100"/>
            <Label fx:id="rentLabel" text="-"
                   style="-fx-text-fill: #fab387; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="👤 Владелец:" style="-fx-text-fill: #bac2de; -fx-font-size: 15px;" minWidth="100"/>
            <Label fx:id="ownerLabel" text="-"
                   style="-fx-text-fill: #89b4fa; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="🏘️ Дома:" style="-fx-text-fill: #bac2de; -fx-font-size: 15px;" minWidth="100"/>
            <Label fx:id="housesLabel" text="-"
                   style="-fx-text-fill: #f9e2af; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="🏨 Отель:" style="-fx-text-fill: #bac2de; -fx-font-size: 15px;" minWidth="100"/>
            <Label fx:id="hotelLabel" text="-"
                   style="-fx-text-fill: #f9e2af; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label fx:id="colorGroupStatusLabel" text=""
                   style="-fx-text-fill: #a6e3a1; -fx-font-size: 14px; -fx-font-weight: bold;"
                   wrapText="true"/>
        </HBox>
    </VBox>

    <VBox spacing="8" alignment="CENTER" style="-fx-padding: 10 0;">
        <Button text="Купить дом" fx:id="buyHouseButton" onAction="#onBuyHouse"
                style="-fx-background-color: linear-gradient(to right, #89b4fa, #74c7ec);
                       -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-font-size: 14px;
                       -fx-cursor: hand;"/>
        <Button text="Купить отель" fx:id="buyHotelButton" onAction="#onBuyHotel"
                style="-fx-background-color: linear-gradient(to right, #f5c2e7, #cba6f7);
                       -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-padding: 8 20; -fx-font-size: 14px;
                       -fx-cursor: hand;"/>
    </VBox>

    <Button text="Закрыть" fx:id="closeButton" onAction="#onClose"
            style="-fx-background-color: #313244; -fx-background-radius: 6;
                   -fx-text-fill: #cdd6f4; -fx-font-weight: bold;
                   -fx-padding: 10 30; -fx-font-size: 14px;
                   -fx-cursor: hand;"/>

</VBox>